## Page Background Config

[predefinedPlain]
Name=Plain
format=plain

[predefinedRuled]
Name=Ruled
format=ruled

[predefinedLined]
Name=Ruled with vertical line
format=lined

[predefinedRightLined]
Name=Ruled with vertical line on the right
format=lined
config=m1=-72

[predefinedStaves]
Name=Staves
format=staves

[predefinedGraph]
Name=Graph
format=graph

[predefinedDotted]
Name=Dotted
format=dotted

[predefinedIsoDotted]
Name=Isometric Dotted
format=isodotted

[predefinedIsoGraph]
Name=Isometric Graph
format=isograph

[graphWithBorder]
Name=Graph with border
format=graph
config=m1=40,rm=1

[graphWithBorderBold5]
Name=Graph with border (bold every 5th)
format=graph
config=m1=20,rm=1,bli=5,blw=1

